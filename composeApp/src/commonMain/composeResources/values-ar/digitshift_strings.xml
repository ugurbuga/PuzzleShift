    <!-- GameTutorialScreen -->
    <string name="tutorial_digitshift_intro_title">اعثر على الرقم السري</string>
    <string name="tutorial_digitshift_intro_body">كوّن رقمًا سريًا من 5 أو 6 خانات باستخدام الأرقام 0–9 ثم أرسله. كل محاولة تكشف الأرقام الصحيحة والموجودة وغير الموجودة.</string>
    <string name="tutorial_digitshift_hints_title">اقرأ الألوان</string>
    <string name="tutorial_digitshift_hints_body">يعني الأخضر أن الرقم صحيح، ويعني البرتقالي أنه موجود في مكان آخر، ويعني الرمادي الداكن أنه غير موجود في الإجابة.</string>
    <string name="tutorial_digitshift_strategy_title">استخدم تلميحات لوحة المفاتيح</string>
    <string name="tutorial_digitshift_strategy_body">كل محاولة تُحدّث لوحة الأرقام. أعد استخدام الأرقام الخضراء، وانقل البرتقالية إلى أماكن جديدة، وتجنب الأرقام الرمادية الداكنة لتحل اللغز أسرع.</string>
    <string name="tutorial_digitshift_ready_title">هل أنت مستعد لكسر الأرقام؟</string>
    <string name="tutorial_digitshift_ready_body">يتناوب الوضع الكلاسيكي بين جولات من 5 و6 خانات حتى تخطئ في رقم. يضيف وضع الهجوم الزمني مزيدًا من الضغط، لذا حل بسرعة لتحصيل النقاط والوقت الإضافي.</string>

    <!-- InteractiveOnboarding -->
