    <string name="interactive_onboarding_digitshift_submit_hint">أرسل رقمًا آخر وشاهد كيف تتحدث لوحة الأرقام.</string>
    <string name="interactive_onboarding_digitshift_solve_hint">استخدم التلميحات واعثر على الرقم السري.</string>

