<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- AppSelectionScreen -->
    <string name="selection_sumshift_desc">数字付きタイルを選んで、各行と各列の合計を外側の目標値に合わせましょう。</string>

    <!-- GameTutorialScreen -->
    <string name="tutorial_sumshift_intro_title">すべての目標合計をそろえよう</string>
    <string name="tutorial_sumshift_intro_body">各ボードの外側には行と列の目標値が表示されます。その合計に含めたい数字マスを選択してください。</string>
    <string name="tutorial_sumshift_targets_title">外側の目標値を確認しよう</string>
    <string name="tutorial_sumshift_targets_body">行または列で選択したマスの合計が、外側の数字とぴったり一致したときだけ目標達成です。</string>
    <string name="tutorial_sumshift_strategy_title">縦横の両方をバランスよく</string>
    <string name="tutorial_sumshift_strategy_body">選んだマスは1つの行と1つの列の両方に影響します。特に盤面が複雑になるほど、縦横の両方を同時に満たす組み合わせを作りましょう。</string>
    <string name="tutorial_sumshift_ready_title">合計を動かす準備はいい？</string>
    <string name="tutorial_sumshift_ready_body">すべての行と列の目標を達成するとパズルクリアとなり、次の盤面に進みます。タイムアタックでは、より速い全達成ほど高く評価されます。</string>

    <!-- InteractiveOnboarding -->
    <string name="interactive_onboarding_sumshift_row_hint">一番上の行の 3 をタップしてください。その行の目標を達成できます。</string>
    <string name="interactive_onboarding_sumshift_column_hint">次に2行目の 2 をタップしてください。この手で列の目標を達成できます。</string>
    <string name="interactive_onboarding_sumshift_finish_hint">3行目の 4 をタップしてください。練習が終わり、本番が始まります。</string>

    <!-- Accessibility -->
    <string name="sumshift_hint_action">ヒントを見る</string>
    <string name="sumshift_mistake_badge_content_description">残りミス回数：%1$d / 1</string>

    <!-- GameScreen -->
    <string name="sumshift_completion_feedback">やった！パズル完成。次の盤面を準備中です。</string>
    <string name="sumshift_summary_rows_label">行</string>
    <string name="sumshift_summary_columns_label">列</string>
    <string name="sumshift_summary_mistakes_label">ミス</string>
    <string name="sumshift_summary_best_label">ベスト</string>

</resources>

