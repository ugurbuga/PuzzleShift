    <!-- GameTutorialScreen -->
    <string name="tutorial_digitshift_intro_title">找出隐藏数字</string>
    <string name="tutorial_digitshift_intro_body">用 0–9 的数字组成一个隐藏的 5 位或 6 位数字并提交。每次猜测都会显示哪些数字正确、存在但位置不对，或根本不存在。</string>
    <string name="tutorial_digitshift_hints_title">读懂颜色</string>
    <string name="tutorial_digitshift_hints_body">绿色表示数字和位置都正确，橙色表示数字存在但位置不对，深灰色表示答案中没有这个数字。</string>
    <string name="tutorial_digitshift_strategy_title">使用键盘提示</string>
    <string name="tutorial_digitshift_strategy_body">每次提交都会更新数字键盘提示。重复利用绿色数字，调整橙色数字的位置，避开深灰色数字，更快解开答案。</string>
    <string name="tutorial_digitshift_ready_title">准备好破解数字了吗？</string>
    <string name="tutorial_digitshift_ready_body">经典模式会在 5 位和 6 位回合之间交替，直到你猜错一个数字。限时模式压力更大，所以要尽快解出以积累分数和奖励时间。</string>

    <!-- InteractiveOnboarding -->
    <string name="interactive_onboarding_digitshift_type_hint">输入提示的数字来熟悉棋盘。</string>
    <string name="interactive_onboarding_digitshift_submit_hint">再提交一个数字，看看数字键盘如何更新。</string>
    <string name="interactive_onboarding_digitshift_solve_hint">利用线索解出隐藏数字。</string>

