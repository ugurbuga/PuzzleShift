<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- AppSelectionScreen -->
    <string name="selection_chainshift_desc">从中心发射，把方块插入螺旋链条中，并消除 3 个或更多同色匹配。</string>

    <!-- ChainShiftGameScreen -->
    <string name="game_message_ad_reward_chainshift">Chain Shift 的当前方块已刷新！</string>

    <!-- GameTutorialScreen -->
    <string name="tutorial_chainshift_intro_title">认识 Chain Shift</string>
    <string name="tutorial_chainshift_intro_body">方块会从边缘进入，绕着棋盘前进并逐步逼近中心。你的发射器固定在中央，所以每一次射击都必须在链条靠近你之前切入移动中的链条。</string>
    <string name="tutorial_chainshift_path_title">瞄准与射击</string>
    <string name="tutorial_chainshift_path_body">从中心瞄准并释放以进行射击。您的方块会在击中链条的地方插入，并将后续方块推向前。</string>
    <string name="tutorial_chainshift_combo_title">创造后退与连击</string>
    <string name="tutorial_chainshift_combo_body">沿链条匹配3个或更多相同颜色的连接方块以消除它们。当间隙关闭时，链条会向边缘后退，可能会触发连锁反应。</string>
    <string name="tutorial_chainshift_ready_title">守住中心</string>
    <string name="tutorial_chainshift_ready_body">保持冷静，让螺旋尽量短，并在危险连段锁住中心之前用射击将其打断。链条越深入中心，你可用于翻盘的空间就越少。</string>

    <!-- InteractiveOnboarding -->
    <string name="interactive_onboarding_chainshift_intro_title">射击引导方块</string>
    <string name="interactive_onboarding_chainshift_intro_body">首先向螺旋线的突出部分开火。您的方块从中心发射，并在撞击点插入链条。</string>
    <string name="interactive_onboarding_chainshift_match_title">做出 3 连匹配</string>
    <string name="interactive_onboarding_chainshift_match_body">现在使用引导射击把 3 个同色方块排成一线。匹配的链段会立刻爆开，并为中心附近腾出空间。</string>
    <string name="interactive_onboarding_chainshift_chain_title">触发连锁反应</string>
    <string name="interactive_onboarding_chainshift_chain_body">这种设置奖励更聪明的射击。清除第一组匹配，观察链条向边缘后退，让第二组匹配自行消除。</string>
    <string name="interactive_onboarding_chainshift_tap_hint">瞄准并释放以射击突出的方块。</string>

</resources>
