<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- AppSelectionScreen -->
    <string name="selection_mergeshift_desc">合并相同数值的方块以获得更高分数。</string>

    <!-- MergeShiftGameScreen -->
    <string name="game_message_ad_reward_mergeshift">数字已更改！继续合并。</string>
    <string name="ad_reward_mergeshift_swap">更换数字</string>
    <string name="feedback_ad_reward_mergeshift">数字已更改</string>

    <!-- GameTutorialScreen -->
    <string name="tutorial_mergeshift_intro_title">发射方块以合并相同数值的方块</string>
    <string name="tutorial_mergeshift_intro_body">在 MergeShift 中，方块从底座发射。当一个方块落在另一个具有相同数值的方块上时，它们会合并成一个更高的数值。继续合并以腾出空间并获得更高分数。</string>
    <string name="tutorial_mergeshift_systems_title">规划你的合并以防止溢出</string>
    <string name="tutorial_mergeshift_systems_body">你发射的每一个方块都会增加列的高度。如果任何列到达顶部，游戏结束。使用预览查看你的方块将落在哪里，以及它可能与哪些方块合并。</string>
    <string name="tutorial_mergeshift_specials_title">组合多次合并以获得更大的连击</string>
    <string name="tutorial_mergeshift_specials_body">单次发射可以触发合并的连锁反应。这些连击会奖励更多分数，并在棋盘上腾出更多空间，帮助你在游戏中坚持更久。</string>
    <string name="tutorial_mergeshift_ready_title">你已准备好玩 MergeShift</string>
    <string name="tutorial_mergeshift_ready_body">专注于保持你的列高度较低，并准备高数值的合并。祝你好运，挑战最高数字！</string>

    <!-- InteractiveOnboarding -->
    <string name="interactive_onboarding_mergeshift_launch_title">发射你的第一个方块</string>
    <string name="interactive_onboarding_mergeshift_launch_body">在棋盘下方水平拖动方块进行瞄准，然后松手将其发射到一列中。</string>
    <string name="interactive_onboarding_mergeshift_merge_vertical_title">垂直合并相同数值</string>
    <string name="interactive_onboarding_mergeshift_merge_vertical_body">将方块发射到已经包含相同数值方块的列中。它们将合并成一个更大的数字！</string>
    <string name="interactive_onboarding_mergeshift_merge_horizontal_title">水平合并相同数值</string>
    <string name="interactive_onboarding_mergeshift_merge_horizontal_body">方块也可以与其左侧或右侧的相邻方块合并。瞄准高亮位置以触发水平合并。</string>
    <string name="interactive_onboarding_mergeshift_merge_multi_title">触发多次合并</string>
    <string name="interactive_onboarding_mergeshift_merge_multi_body">单次放置可以触发多个方向（上方、左侧、右侧）的合并。利用这一点腾出更多空间并获得高分！</string>

</resources>
