<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- AppSelectionScreen -->
    <string name="selection_sumshift_desc">숫자 타일을 선택해 각 행과 열의 합이 바깥쪽 목표 합과 일치하도록 만드세요.</string>

    <!-- GameTutorialScreen -->
    <string name="tutorial_sumshift_intro_title">모든 목표 합 맞추기</string>
    <string name="tutorial_sumshift_intro_body">각 보드의 격자 바깥에는 행과 열 목표가 표시됩니다. 그 합계에 포함되어야 할 숫자 칸을 선택하세요.</string>
    <string name="tutorial_sumshift_targets_title">바깥 목표 읽기</string>
    <string name="tutorial_sumshift_targets_body">해당 행 또는 열에서 선택한 칸의 합이 보드 바깥 숫자와 정확히 같을 때만 목표가 완료됩니다.</string>
    <string name="tutorial_sumshift_strategy_title">가로와 세로를 함께 맞추기</string>
    <string name="tutorial_sumshift_strategy_body">선택한 각 칸은 행 하나와 열 하나에 동시에 영향을 줍니다. 특히 보드가 더 빽빽해질수록 두 방향을 동시에 만족하는 해법을 만드세요.</string>
    <string name="tutorial_sumshift_ready_title">합계를 움직일 준비가 됐나요?</string>
    <string name="tutorial_sumshift_ready_body">모든 행과 열 목표를 완료하면 퍼즐을 클리어하고 다음 보드로 넘어갑니다. 타임어택에서는 더 빠른 전체 해결이 더 큰 보상이 됩니다.</string>

    <!-- InteractiveOnboarding -->
    <string name="interactive_onboarding_sumshift_row_hint">맨 윗줄의 3을 탭하세요. 그러면 그 행 목표가 완료됩니다.</string>
    <string name="interactive_onboarding_sumshift_column_hint">이제 둘째 줄의 2를 탭하세요. 이 움직임으로 열 목표가 완료됩니다.</string>
    <string name="interactive_onboarding_sumshift_finish_hint">셋째 줄의 4를 탭하세요. 연습이 끝나고 실제 게임이 시작됩니다.</string>

    <!-- Accessibility -->
    <string name="sumshift_hint_action">힌트 보기</string>
    <string name="sumshift_mistake_badge_content_description">남은 실수: 1회 중 %1$d회</string>

    <!-- GameScreen -->
    <string name="sumshift_completion_feedback">잘했어요! 퍼즐을 완료했습니다. 다음 보드를 준비 중입니다.</string>
    <string name="sumshift_summary_rows_label">행</string>
    <string name="sumshift_summary_columns_label">열</string>
    <string name="sumshift_summary_mistakes_label">실수</string>
    <string name="sumshift_summary_best_label">최고</string>

</resources>

