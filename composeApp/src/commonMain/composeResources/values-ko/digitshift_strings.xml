    <!-- GameTutorialScreen -->
    <string name="tutorial_digitshift_intro_title">숨겨진 숫자 찾기</string>
    <string name="tutorial_digitshift_intro_body">0–9 숫자로 5자리 또는 6자리의 숨겨진 숫자를 만들고 제출하세요. 각 추측은 어떤 숫자가 정확한지, 포함되어 있는지, 아예 없는지 알려 줍니다.</string>
    <string name="tutorial_digitshift_hints_title">색을 읽어 보세요</string>
    <string name="tutorial_digitshift_hints_body">초록색은 숫자와 위치가 모두 맞다는 뜻이고, 주황색은 숫자는 있지만 위치가 다르다는 뜻이며, 진한 회색은 정답에 없다는 뜻입니다.</string>
    <string name="tutorial_digitshift_strategy_title">키패드 힌트를 활용하세요</string>
    <string name="tutorial_digitshift_strategy_body">추측을 제출할 때마다 숫자 키패드 힌트가 업데이트됩니다. 초록 숫자는 유지하고, 주황 숫자는 위치를 바꾸며, 진한 회색 숫자는 피해서 더 빨리 해결하세요.</string>
    <string name="tutorial_digitshift_ready_title">숫자를 풀 준비됐나요?</string>
    <string name="tutorial_digitshift_ready_body">클래식 모드는 숫자를 놓칠 때까지 5자리와 6자리 라운드를 번갈아 진행합니다. 타임 어택은 압박을 더하므로 빠르게 풀어 점수와 보너스 시간을 쌓으세요.</string>

    <!-- InteractiveOnboarding -->
